# 環境ごとの秘密・生成物
/.env
/.env.bak

# Claude Code の個人設定（共有しない。共有は .claude/settings.json）
/.claude/settings.local.json

# IDE の個人設定。Include Path も CLI インタプリタもホストのパスや Docker の
# コンテキストに依存するので、共有しても他の環境では使えない。
/.idea/

# EC-CUBE 本体はイメージにベイクするので、このリポジトリには持たない。
# app/ 配下（Customize / template / DoctrineMigrations / config）は
# あなたの成果物なので Git 管理する。
/var/

# IDE にコード補完を効かせるための本体・vendor の複製（bin/ide-sync.sh が作る）。
# イメージの中身をそのまま写しただけなので追跡しない。消しても作り直せる。
/.ide/

# フロントビルドの依存（生成物）。scss ソースと成果物 css は Git 管理する。
/frontend/node_modules/
/html/user_data/assets/css/*.map

# eccube:install が rw マウントへコピーする本体既定ファイル（自分の資産ではない）
/html/user_data/assets/img/
/html/user_data/assets/pdf/

# 導入したプラグインは各自の repo で管理する（この repo では追跡しない）。
# .gitkeep だけ残す。
/app/Plugin/*
!/app/Plugin/.gitkeep

# プラグイン有効化時に本体が Resource/template/ からコピーしてくる生成物。
# 中身はプラグイン側と同一で、そちらの repo が持つべきもの。
# 自分で書いた上書きテンプレートは app/template/default/ 直下に置くので影響しない。
/app/template/default/CustomerGroup*/
/backups/

# プラグインが有効化のときにテーマへ写すテンプレート。
# 本体はテーマを起点にファイルを解決するので、プラグインの中に置いたままでは
# 引けない（メールは「Unable to find template」、ページ管理は 500）。
#
# 写しなので追跡しない。無効化→有効化で作り直せる。先頭の
# `{# <プラグイン名>-template: <ハッシュ> #}` は、店が直したかどうかを
# プラグインが見分けるための目印。
#
# **店が直したものは追跡すること。** `git add -f app/template/default/<コード>/...`
/app/template/default/B2BCompany/
/app/template/default/B2BOrderApproval/
/app/template/default/CustomerApproval/
/app/template/default/OrderDeliveryPlace/
/app/template/default/OrderPad/
/app/template/default/OrderQuote/
/app/template/default/OrderRecurring/
/app/template/default/ProductCompare/
/app/template/default/ProductSample/

# ページ管理（コンテンツ管理）から作ったページ。管理画面で作るものなので
# 環境のデータであって、リポジトリの成果物ではない。
/app/template/user_data/

