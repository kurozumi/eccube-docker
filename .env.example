# ========================================================================
# EC-CUBE Docker 汎用環境 設定サンプル
#   cp .env.example .env して編集する（.env は .gitignore 済み）。
#   bin/init.sh を使うと .env 作成と ECCUBE_AUTH_MAGIC 生成まで自動で行う。
# ========================================================================

# ---- EC-CUBE 本体 ----
# composer create-project のバージョン制約。切替は bin/switch-version.sh を使う。
#   4.3系: ~4.3.0  /  4.2系: ~4.2.0  /  4.1系: ~4.1.0
#   4.4系: 4.4.x-dev … **リリースがまだ無く、上流にあるのはブランチだけ。**
#         `~4.4.0` は解決できない。動く的なので、build するたび中身が変わる。
#
# **配布イメージを使う場合、ここは build にしか使われない。** 実際に動くのは
# ECCUBE_IMAGE のタグに焼かれたバージョンになる（下記）。
ECCUBE_VERSION=~4.3.0
# 手元で build するときの PHP。配布イメージなら ECCUBE_IMAGE のタグで選ぶ（下記）。
# 上流の対応: 4.2 → 7.4–8.1 / 4.3 → 8.1–8.3 / 4.4 → 8.2–8.5
PHP_VERSION=8.2
# phpredis。系列で決まり、両立しない（4.2/4.3: 6.0.2 / 4.4: 6.3.0）。
# bin/switch-version.sh が ECCUBE_VERSION に合わせて書き換える。手で 4.4 にするなら 6.3.0。
PHPREDIS_VERSION=6.0.2

# 配布イメージ。設定すると build せず pull して使う（起動が数分 → 数十秒になる）。
# 未設定ならこれまでどおり手元で build する（本体を改造する人はこちら）。
#
#   ECCUBE_IMAGE=ghcr.io/<owner>/<repo>/ec-cube:4.3            **本番はこれ。** 毎週焼き直され、
#                                                             PHP と Debian のパッチが入る。bin/deploy.sh が引き直す
#   ECCUBE_IMAGE=ghcr.io/<owner>/<repo>/ec-cube:4.3-php8.3     PHP を選ぶ（4.2: 8.1/8.2、4.3: 8.1/8.2/8.3、4.4: 8.2〜8.5）
#   ECCUBE_IMAGE=ghcr.io/<owner>/<repo>/ec-cube:4.3-20260907   日付で固定。同じものを何度も立てる人向け
#   ECCUBE_IMAGE=ghcr.io/<owner>/<repo>/ec-cube:4.3-v1.0.0     リリース時点で固定（パッチは入らない）
#
# **タグは必ず系列（4.3 など）で始まるものを選ぶ。** bin/upgrade.sh と
# bin/switch-version.sh は、系列を動かすときこの部分だけを書き換える。
# 系列で始まらないタグは書き換えず、警告して素通りする。
#
# 環境そのもの（bin/ や compose）の更新は bin/self-update.sh、
# 中身（EC-CUBE 本体）の更新は bin/upgrade.sh。**別のもの**なので docs/distribute.md を読むこと。
#ECCUBE_IMAGE=

# 実行モード。既定は本番。開発でデバッグしたいときだけ dev / 1 にする。
APP_ENV=prod
APP_DEBUG=0
ECCUBE_LOCALE=ja
# 管理画面の URL（/admin/ → /<この値>/）。bin/init.sh が admin-<乱数> にする。推測されにくくするため
ECCUBE_ADMIN_ROUTE=admin
# 初期管理者（ログイン ID admin）のパスワード。**インストールの瞬間にしか効かない**
# （本体の fixtures が読む）。bin/init.sh が生成する。password のままだと bin/publish.sh が止める。
# あとから変えるのは管理画面 → 設定 → システム設定 → メンバー管理
ECCUBE_ADMIN_PASS=password

# テーマ。default は本体のテーマ。オリジナルテーマは original に固定
# （compose が html/template/original を bind mount している。bin/theme.sh init で
# 本体の静的物を写してから切り替える）。
# **管理画面のテンプレート管理からは変えられない**。あちらはコンテナ内の .env に
# 書くので bin/upgrade.sh で消える。ここに書けば upgrade を越えて保たれる。
ECCUBE_TEMPLATE_CODE=default

# アプリのシークレット。空のままだと bin/console が落ちる。
# bin/init.sh が未設定/プレースホルダなら自動生成する（openssl rand -hex 16）。
# 手動なら: openssl rand -hex 16 の値を入れる。本番では必ず固有の値にすること。
ECCUBE_AUTH_MAGIC=change_this_to_a_random_hex_string

# ---- 本番（Linux）の所有者合わせ ----
# コンテナの www-data を、このサーバーで deploy する自分のユーザーと同じ uid/gid にする。
# 値は `id -u` と `id -g`。揃えないと、管理画面が書いたファイルを git pull が上書きできず、
# 自分が置いたファイルを管理画面が書けない（欄が空に見える）。macOS では不要。
#PUID=1000
#PGID=1000

# ---- EC-CUBE に渡す任意の設定 ----
# この .env は**アプリのコンテナに丸ごとは渡らない**（渡るのは compose.yaml の environment に
# 列挙したものだけ。DB_ROOT_PASSWORD や TUNNEL_TOKEN をアプリに乗せないため）。
# EC-CUBE 本体の任意の設定（ECCUBE_COOKIE_LIFETIME / ECCUBE_ADMIN_ALLOW_HOSTS /
# ECCUBE_FORCE_SSL 等、本体の .env.dist にある名前）を渡すときは、隣の .env.app に書く:
#   echo 'ECCUBE_ADMIN_ALLOW_HOSTS=["203.0.113.10"]' >> .env.app
# .env.app は git に入れない（.gitignore 済み）。backup.sh が host.app.env として退避する。

# ---- データベース ----
# 種類は mysql（MariaDB / MySQL、既定）か postgresql。**bin/init.sh が .env を作るときに
# COMPOSE_FILE を組み立てる**ので、あとから変えるなら bin/init.sh を打ち直す（DB は作り直し）。
DB_ENGINE=mysql
# 手元の db サービスの版。変えると DB は作り直し（データの版をまたぐ移行は DB 側の手順に従う）
#MARIADB_VERSION=10.6      # mysql のとき。10.6 / 10.11 / 11.4 …。MySQL 本家なら MARIADB_IMAGE=mysql と 8.4
#PG_VERSION=16             # postgresql のとき。14 / 15 / 16 / 17
# 外部 DB で版が違うときだけ、Doctrine に伝える版を上書きする（普段は上の値から作る）
#DATABASE_SERVER_VERSION=mariadb-10.6.0
#PG_SERVER_VERSION=16
DB_NAME=eccube_db
DB_USER=eccube
DB_PASSWORD=eccube_pass
DB_ROOT_PASSWORD=change_me_root

# ---- メール ----
# 開発は未設定でよい（compose.override.yaml が自動で Mailpit 宛てにする）。
# 本番は実メールサービスの DSN を設定する。未設定なら送信は破棄される（null://null）。
#   例: MAILER_DSN=smtp://user:pass@smtp.example.com:587
#MAILER_DSN=

# ---- 開発時のポート ----
HTTP_PORT=8080
# 開発のポート（nginx / phpMyAdmin / Mailpit）を開く先。既定は手元だけ。
# 同じ LAN のスマホ等から見るなら 0.0.0.0（phpMyAdmin は自動ログインなので注意）
#DEV_BIND=127.0.0.1
MAILPIT_UI_PORT=8025
PMA_PORT=8081

# ---- パフォーマンス / スケール（Tier 1）----
# php-fpm ワーカー数。サーバーの CPU/メモリに合わせて調整する。
#   max_children ≒ (PHP に割り当てるメモリ) / (1プロセスの実測メモリ ~80MB)
PHP_FPM_PM=dynamic
PHP_FPM_MAX_CHILDREN=20
PHP_FPM_START_SERVERS=4
PHP_FPM_MIN_SPARE=2
PHP_FPM_MAX_SPARE=6
PHP_FPM_MAX_REQUESTS=500
# ---- 任意機能（初回は無効。COMPOSE_PROFILES に名前を足すと有効）----
#   redis     … アプリキャッシュとセッションを Redis に（複数ホストの前提）
#   messenger … メール送信を非同期に（worker がキューを消化。SMTP 障害から購入を切り離す）
# サービスの起動と設定の投入は**同じ値**で決まる（entrypoint が COMPOSE_PROFILES を読む）。
# 片方だけ有効にする手段は無く、それが事故を防ぐ。
# **redis を有効/無効にした瞬間、全員ログアウトになる**（セッションの置き場が変わる）。
# 本番で切り替えるなら時間を選ぶ。以下の REDIS_* は redis を有効にしたときだけ使われる。

# Symfony アプリキャッシュの Redis 共有。既定はローカルの redis サービス。
# 本番でマネージド Redis を使うなら redis://user:pass@host:6379 の形で上書き。
REDIS_URL=redis://redis:6379
REDIS_MAXMEMORY=256mb
# セッション保存用 Redis（Tier 2: 複数ホストでセッション共有）。キャッシュ用とは別。
# 本番でマネージド Redis を使うなら上書きする。
SESSION_REDIS_URL=redis://redis-session:6379
# セッション Redis の上限（OOM 防止）。1 セッション数 KB × 想定同時セッション数が目安。
# 256mb ≈ 数万〜十数万セッション。到達時は新規セッションの書込エラー（既存は守られる）。
SESSION_REDIS_MAXMEMORY=256mb

# ---- バックアップの送り先（任意）----
# backups/ は同じディスクにできる。サーバーごと失うと一緒に消えるので、外へ送る。
# 書いてあれば bin/backup.sh の最後に送り、送れなければ失敗にする（黙って飛ばさない）。
#   BACKUP_SYNC=rclone:r2:myshop-backups          rclone（S3 / Cloudflare R2 / Google Drive / NAS）
#   BACKUP_SYNC=backup@nas.local:/srv/eccube      rsync over ssh
#   BACKUP_SYNC=/mnt/nas/eccube                   rsync（マウント済みの NAS）
#BACKUP_SYNC=

# ---- 複数ホスト（compose.app.yaml で各アプリホストを起動するとき）----
# 前段 LB の IP/サブネットを信頼して X-Forwarded-* を honor（HTTPS 判定に必須）。
# バックアップの暗号化。書くと backup.sh が全ファイルを AES-256 で暗号化し、平文を残さない。
# **鍵を無くすと全世代が読めなくなる。** パスワードマネージャにも控えること。
# 引っ越し先では restore.sh の前に同じ値を .env に写す。
#   openssl rand -base64 32 で作る
#BACKUP_ENCRYPT_KEY=

# 空だと LB 背後で HTTPS を認識できず、SameSite=None セッションや URL 生成が壊れる。
# **本番（compose.prod.yaml）の既定は REMOTE_ADDR（直前の peer を信頼）。** tunnel / caddy /
# ホスト nginx のどれでも、nginx は 127.0.0.1 にしか開いていないので直前の peer は公開層だけ。
# 複数ホスト（compose.app.yaml）では LB のサブネットに絞る:
#   例: TRUSTED_PROXIES=10.0.0.0/8
#TRUSTED_PROXIES=
# DB_HOST / REDIS_URL / SESSION_REDIS_URL を外部の共有サービスに向ける:
#   DB_HOST=10.0.0.10
#   DB_PORT=3306          … bin/backup.sh / restore.sh はこの DB_* で外部 DB に繋ぐ（DB_ENGINE に従う。postgresql なら 5432）
#   REDIS_URL=redis://10.0.0.20:6379
#   SESSION_REDIS_URL=redis://10.0.0.21:6379
# アプリ専用ホストはスキーマに触らない（init ロール 1 台だけ 0 にする）:
#   ECCUBE_SKIP_DB_INIT=1
# アプリホストの nginx を束縛する IP。LB から到達できるプライベート側の IP にする
# （既定 0.0.0.0。公開 IP にも開いていると LB をバイパスされる）:
#   HTTP_BIND=10.0.0.11
# CI が push したイメージを使う（未指定ならローカル build）。sha 固定を推奨:
#   ECCUBE_IMAGE=ghcr.io/<owner>/<repo>/ec-cube:<git-sha>
# ※ MariaDB の innodb_buffer_pool_size 等は docker/mariadb/conf.d/eccube.cnf で調整。
#    OPcache は APP_ENV=prod のとき entrypoint が validate_timestamps=0 に切替える。

# ========================================================================
# 本番公開（compose.prod.yaml を使うとき）
#   次行を有効化すると docker compose の -f を省略できる:
# COMPOSE_FILE=compose.yaml:compose.prod.yaml
#
# 公開方式を選ぶ（tunnel / caddy / 空=背後配置）:
# ========================================================================
# 任意機能もここで選ぶ（カンマ区切り）。例:
#   COMPOSE_PROFILES=tunnel,redis,messenger
# **`docker compose --profile` の CLI 指定は entrypoint に届かない。必ずここに書く。**
COMPOSE_PROFILES=tunnel

# tunnel 用: Cloudflare Zero Trust で発行したトークン
#TUNNEL_TOKEN=

# caddy 用: 公開ドメイン（A レコードをこのサーバーへ向ける）
#SITE_DOMAIN=shop.example.com
