<?xml version="1.0" encoding="UTF-8"?>
<!--
  自分のコード（app/Customize/）向けのユニットテスト設定。
  EC-CUBE 本体のフルスイート（DB が要る・重い）は image の phpunit.xml.dist に残しており、
  必要なときだけ `vendor/bin/phpunit -c phpunit.xml.dist` で実行する。

  testsuite は app/Customize/Tests/ だけを対象にするが、パスを直接渡せば
  （例: bin/test.sh app/Plugin/Foo/Tests）任意のテストもこの設定で実行できる。

  DAMA\DoctrineTestBundle のリスナーを入れているので、DB を使う統合テスト
  （Eccube\Tests\EccubeTestCase 等）を書いても各テストがトランザクションで
  包まれてロールバックされ、DB にデータが残らない。これが無いと実行のたびに
  レコードが積み上がり、件数を前提にしたテストが後から壊れる。
  バンドルは本体が test 環境向けに登録済み（app/config/eccube/bundles.php）。
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="tests/bootstrap.php"
>
    <php>
        <!-- 本体の phpunit.xml.dist に合わせる。コンテナの CLI は memory_limit=256M で、
             商品を作る統合テストが数十件並ぶと足りなくなり、テスト本体とは無関係な
             OutOfMemoryError で落ちる。 -->
        <ini name="memory_limit" value="-1" />
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="KERNEL_CLASS" value="Eccube\Kernel" />
        <server name="SYMFONY_DEPRECATIONS_HELPER" value="weak" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
    </php>

    <!-- 各テストをトランザクションでロールバックし、DB を汚さないようにする。
         PHPUnit 10 以降は <listeners> が廃止されたため <extensions> で登録する。 -->
    <extensions>
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension" />
    </extensions>

    <testsuites>
        <testsuite name="Customize Test Suite">
            <directory>app/Customize/Tests</directory>
        </testsuite>
    </testsuites>

    <!-- PHPUnit 10 以降、対象の指定は <source> へ移った。 -->
    <source>
        <include>
            <directory suffix=".php">app/Customize</directory>
        </include>
        <exclude>
            <directory suffix=".php">app/Customize/Tests</directory>
            <directory suffix=".php">app/Customize/Resource</directory>
        </exclude>
    </source>
</phpunit>
