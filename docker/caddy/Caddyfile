# caddy プロファイル用。ドメイン＋80/443 でどの VPS/AWS でも自動 HTTPS。
# SITE_DOMAIN は .env で指定（未設定なら :80 でリッスン）。
# web ルートはプロジェクトルート（/var/www/html）、フロントは index.php。
{$SITE_DOMAIN::80} {
	root * /var/www/html
	encode gzip zstd

	# nginx（docker/nginx/default.conf）と同じヘッダ。Server ヘッダは消す（版が外に出る）。
	# defer: PHP（php_fastcgi）が返すヘッダにも、書き出す直前に効かせる
	header {
		defer
		-Server
		-X-Powered-By
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# アプリ内部ディレクトリ・ドットファイルへの直接アクセスを禁止。
	# ドットファイルはどの階層でも（/foo/.git も）。nginx の `location ~ /\.` と同じ
	@denied {
		path /var/* /tests/* /test/* /vendor/* /app/* /src/* /bin/*
	}
	@dotfiles path_regexp /\.
	respond @denied 403
	respond @dotfiles 403

	# 静的ファイルのキャッシュ（nginx の default.conf と同じ。理由もそちら）。
	# 名前の変わらない CSS / JS / テーマの画像は 5 分、名前が毎回変わる商品画像だけ 30 日。
	# 2 つの matcher が重ならないように、汎用のほうから商品画像を外す
	@productImage path_regexp productImage ^/html/upload/save_image/[^/]+\.(?i:jpg|jpeg|png|gif|webp|avif|svg)$
	@asset {
		path_regexp asset \.(?i:css|js|mjs|jpg|jpeg|png|gif|ico|svg|webp|avif|woff|woff2|ttf|otf|eot)$
		not path_regexp ^/html/upload/save_image/[^/]+\.(?i:jpg|jpeg|png|gif|webp|avif|svg)$
	}
	header @productImage Cache-Control "public, max-age=2592000"
	header @asset Cache-Control "public, max-age=300"

	php_fastcgi ec-cube:9000
	file_server
}
