# 自前運用の外部ロードバランサ（別ホスト/別コンテナの nginx）の設定例。
# 複数のアプリホスト（各ホストで compose.app.yaml を起動）へ振り分ける。
# クラウドの Cloudflare Load Balancing / AWS ALB を使う場合はこのファイルは不要
# （それぞれのダッシュボードで同じことを設定する。docs/scale.md「複数ホスト + ロードバランサ」）。
# ホストを 1 台ずつ更新するときは、その行に down を付けて nginx -s reload する。
#
# 使い方の例（LB ホストで）:
#   docker run -d --name eccube-lb -p 80:80 -p 443:443 \
#     -v $PWD/docker/nginx/lb.conf.example:/etc/nginx/conf.d/default.conf:ro \
#     nginx:1.30-alpine

upstream eccube_app_hosts {
    # セッションは Redis 共有なのでスティッキー不要。接続数最少のホストへ回す。
    least_conn;
    # 各アプリホストの nginx（compose.app.yaml の HTTP_PORT。既定 8080）
    server 10.0.0.11:8080 max_fails=3 fail_timeout=10s;
    server 10.0.0.12:8080 max_fails=3 fail_timeout=10s;
    # server 10.0.0.13:8080 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

server {
    listen 80;
    # 本番は HTTPS をここで終端する。
    # **HTTP/2 と TLS 1.3 を受けるのは nginx 1.30.7 / 1.31.9 以上で。** それより前は
    # CVE-2026-123007（HTTP/2 flow control のメモリ破壊、RCE、CVSS 9.2）と
    # CVE-2026-118899（TLS 1.3 で無限ループ）の対象。`docker pull` し直すこと。
    # （`listen ... http2` は 1.25 から非推奨。`http2 on;` を使う）
    # listen 443 ssl;
    # http2 on;
    # ssl_certificate     /etc/nginx/certs/fullchain.pem;
    # ssl_certificate_key /etc/nginx/certs/privkey.pem;
    server_name shop.example.com;

    client_max_body_size 64M;

    # HTTP→HTTPS リダイレクト（HTTPS 終端時）
    # if ($scheme = http) { return 301 https://$host$request_uri; }

    location / {
        proxy_pass http://eccube_app_hosts;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        # ↓ アプリ側が HTTPS を認識するために必須。各アプリホストの TRUSTED_PROXIES は
        #   既定（REMOTE_ADDR）のままにする。LB のサブネットを書くと HTTPS と判定されない
        #   （各ホストの nginx がお客さんの IP に置き換えて渡すため。docs/scale.md「HTTPS の判定」）。
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_next_upstream error timeout http_502 http_503;
    }
}
